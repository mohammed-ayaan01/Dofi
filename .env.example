# ==============================================================================
# Dofi — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development server:
#   cp .env.example .env
#
# NOTE: Firebase client credentials are NOT loaded from environment variables.
# They are read directly from firebase-applet-config.json in the repository root.
# See README.md Section 9 for details on configuring Firebase.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GEMINI_API_KEY
# ------------------------------------------------------------------------------
# PURPOSE:
#   Authenticates server-side requests to the Google Gemini API (@google/genai SDK)
#   for auxiliary AI features (Donor Eligibility Pre-Screening, Emergency Dispatch,
#   Lab Report Interpretation, and Gratitude Letters).
# WHERE IT IS USED:
#   server.ts (Express server backend). Never exposed to browser / frontend client.
# REQUIRED/OPTIONAL:
#   OPTIONAL for core blood donation coordination (Firebase Auth + Firestore).
#   REQUIRED if testing or using Gemini AI-assisted endpoints.
#   If omitted, AI endpoints return clearly-labelled prototype fallbacks.
# EXAMPLE FORMAT:
#   Obtain a free or tier key from Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY=AIzaSyYourActualKeyHereWithoutQuotesOrWhitespace

# ------------------------------------------------------------------------------
# 2. PORT
# ------------------------------------------------------------------------------
# PURPOSE:
#   Defines the local port number on which the Express server and Vite middleware listen.
# WHERE IT IS USED:
#   server.ts (line 17)
# REQUIRED/OPTIONAL:
#   OPTIONAL. Defaults to 3000 if not specified.
# EXAMPLE FORMAT:
PORT=3000

# ------------------------------------------------------------------------------
# 3. NODE_ENV
# ------------------------------------------------------------------------------
# PURPOSE:
#   Sets the Node.js execution environment mode (development or production).
# WHERE IT IS USED:
#   server.ts (controls whether Vite dev middleware or static dist/ files are served)
# REQUIRED/OPTIONAL:
#   OPTIONAL. Defaults to development when running `npm run dev`.
# EXAMPLE FORMAT:
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. ERAKTKOSH_INSTITUTION_TOKEN & ERAKTKOSH_HOSPITAL_CODE (Optional Adapter)
# ------------------------------------------------------------------------------
# PURPOSE:
#   Future institutional credentials for e-RaktKosh (MoHFW Blood Bank Platform).
#   e-RaktKosh does NOT offer a public API; credentials are issued by the Ministry
#   of Health & Family Welfare strictly to licensed blood banks.
# WHERE IT IS USED:
#   server.ts (/api/external/eraktkosh adapter status endpoint)
# REQUIRED/OPTIONAL:
#   OPTIONAL. Leave commented out during development/evaluation.
# EXAMPLE FORMAT:
# ERAKTKOSH_INSTITUTION_TOKEN=your_mohfw_issued_token
# ERAKTKOSH_HOSPITAL_CODE=your_eraktkosh_hospital_code
